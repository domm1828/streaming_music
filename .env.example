# ─── Stream Music — variables de entorno ───
# Copiá este archivo a .env y completá los valores.

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos (Phase 0)
MONGODB_URI=mongodb://localhost:27017/stream_music

# Cola / caché (Phase 4+, BullMQ)
REDIS_URL=redis://localhost:6379

# Búsqueda (Phase 4, Meilisearch) — driver: auto | meili | mongo
# 'auto' usa Meilisearch si está accesible; si no, cae al índice de texto de Mongo.
SEARCH_DRIVER=auto
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# Autenticación JWT (Phase 1)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Proveedores de metadatos (Phase 5)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
RAPIDAPI_KEY=

# Pagos (Phase 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Almacenamiento de medios — driver: local | s3
# 'local' guarda en disco y sirve /uploads. 's3' usa cualquier backend
# S3-compatible (SeaweedFS, MinIO, AWS S3). El bucket se crea solo si falta.
STORAGE_DRIVER=local
# Ejemplo con el SeaweedFS de docker-compose (STORAGE_DRIVER=s3):
#   S3_ENDPOINT=http://localhost:8333
#   S3_REGION=us-east-1
#   S3_BUCKET=stream-music
#   S3_ACCESS_KEY=streammusic
#   S3_SECRET_KEY=streammusic-secret-change-me
#   S3_PUBLIC_URL=http://localhost:8333/stream-music
#   S3_PUBLIC_READ=true
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Base pública para las URLs de assets servidos desde S3 (normalmente
# <endpoint>/<bucket>, o el dominio del CDN delante del bucket). Si se deja
# vacío con driver s3, se deriva de S3_ENDPOINT/S3_BUCKET.
S3_PUBLIC_URL=
# Lectura pública del bucket (CDN o acceso anónimo, como el SeaweedFS de dev):
# 'true' hace que los archivos privados (audio) se sirvan por su URL pública. Si el
# bucket es privado (p. ej. AWS S3 sin acceso anónimo), dejalo en blanco/false para
# que se usen URLs presigned temporales.
S3_PUBLIC_READ=
# Secreto para firmar URLs de archivos privados (driver local). Cambialo en prod.
STORAGE_SIGNING_SECRET=

# Login social (Phase 8)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Twitter/X OAuth 2.0 (el email requiere acceso elevado de la app en X)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Email (Phase 7)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@streammusic.local

# Biblioteca / escucha — límite mensual de minutos (0 = ilimitado)
LISTEN_MINUTES_LIMIT=0

# IA
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Proveedor de embeddings: openai | gemini (default openai)
AI_EMBEDDINGS_PROVIDER=openai

# Monitoreo (Phase 8)
SENTRY_DSN=
APP_RELEASE=
# Frontend (build): VITE_SENTRY_DSN, VITE_APP_RELEASE
