# ─── Stream Music — variables de PRODUCCIÓN ───
# Copiá a .env.production y completá los valores. Se usa en dos lugares:
#   1) sustitución de variables del compose (DOMAIN, MONGO_ROOT_*)
#   2) env_file del contenedor de la API (el resto)
# Arranque:  docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# NO commitees este archivo con valores reales. Mantené los secretos fuera del repo.

# ── Dominio público (TLS automático de Caddy) ──
DOMAIN=stream.duglasm.com

# ── App / API ──
NODE_ENV=production
# Mismo origen que el front: con credenciales no puede ser '*'.
CORS_ORIGIN=https://stream.duglasm.com
# A dónde vuelve el login social y a qué apuntan los links de email.
APP_URL=https://stream.duglasm.com

# ── Base de datos (MongoDB del HOST, instalado en el VPS, NO en un contenedor) ──
# El contenedor de la API alcanza al host por 'host.docker.internal' (mapeado a la
# IP del host en docker-compose.prod.yml). Requisitos en el VPS:
#   1) Mongo debe escuchar en la interfaz del bridge de Docker (o 0.0.0.0 con
#      firewall), no solo en 127.0.0.1 → en /etc/mongod.conf: net.bindIp con la IP
#      del gateway de Docker (p.ej. 172.17.0.1) o 0.0.0.0, y reiniciar mongod.
#   2) Usá un usuario de la base con auth (no el root). authSource = la base donde
#      creaste el usuario (admin si lo creaste ahí).
MONGODB_URI=mongodb://streammusic:CAMBIA-clave-de-mongo@host.docker.internal:27017/stream_music?authSource=admin

# ── Secretos JWT y firma de URLs (generá cada uno distinto: openssl rand -base64 48) ──
JWT_ACCESS_SECRET=CAMBIA-access-secret
JWT_REFRESH_SECRET=CAMBIA-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STORAGE_SIGNING_SECRET=CAMBIA-signing-secret

# ── Almacenamiento de medios (SeaweedFS detrás del dominio) ──
STORAGE_DRIVER=s3
# Endpoint interno para el SDK (PUT/HEAD/crear bucket): nombre de servicio del compose.
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=stream-music
# Deben coincidir con docker/seaweedfs/s3.json (¡cambiá el secret por defecto!).
S3_ACCESS_KEY=streammusic
S3_SECRET_KEY=CAMBIA-el-secret-de-seaweedfs
# URL pública navegable de los assets, servida por Caddy en /s3/<bucket>.
S3_PUBLIC_URL=https://stream.duglasm.com/s3/stream-music
# El bucket sirve lectura pública/anónima (como en dev): entrega URLs públicas, no presigned.
S3_PUBLIC_READ=true

# ── Email (SMTP real de producción; password resets y verificación) ──
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_FROM=Stream Music <no-reply@duglasm.com>

# ── Seeder del admin inicial (npm/seed:prod) — ver DEPLOYMENT.md ──
ADMIN_EMAIL=admin@duglasm.com
ADMIN_PASSWORD=CAMBIA-clave-admin-min-8

# ── Opcionales ──
# Búsqueda: 'auto' (default) usa Mongo si no hay Meilisearch. Dejar sin MEILI_HOST.
# SEARCH_DRIVER=auto
# Monitoreo de errores:
# SENTRY_DSN=
# APP_RELEASE=
# Proveedores de metadatos / IA (si se usan):
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# OPENAI_API_KEY=
# Login social (callbacks: https://stream.duglasm.com/api/v1/auth/social/<prov>/callback):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
