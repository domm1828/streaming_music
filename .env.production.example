# ─── Stream Music — variables de PRODUCCIÓN ───
# La API corre en el HOST con PM2 y lee este archivo como .env en la raíz del repo:
#   cp .env.production.example .env     # (en el VPS)
# En Docker solo va SeaweedFS, así que la API usa 127.0.0.1 para Mongo y S3.
#
# NO commitees este archivo con valores reales. Mantené los secretos fuera del repo.

# ── Dominio público ──
# El TLS y el ruteo los hace nginx en el host (docker/nginx/stream-music.conf.example).
# Se deja como referencia del dominio a configurar en ese archivo.
DOMAIN=stream.duglasm.com

# ── App / API ──
NODE_ENV=production
PORT=3000
# Carpeta de trabajo de la API (temporales de TUS y, con driver local, /uploads).
STORAGE_DIR=/opt/streaming_music/storage
# Mismo origen que el front: con credenciales no puede ser '*'.
CORS_ORIGIN=https://stream.duglasm.com
# A dónde vuelve el login social y a qué apuntan los links de email.
APP_URL=https://stream.duglasm.com

# ── Base de datos (MongoDB del HOST; la API corre en el host, así que es localhost) ──
# Usá un usuario de la base con auth (no el root). authSource = la base donde creaste
# el usuario. Mongo puede quedarse en bindIp 127.0.0.1 (no hace falta exponerlo).
MONGODB_URI=mongodb://streammusic:CAMBIA-clave-de-mongo@127.0.0.1:27017/stream_music?authSource=stream_music

# ── Secretos JWT y firma de URLs (generá cada uno distinto: openssl rand -base64 48) ──
JWT_ACCESS_SECRET=CAMBIA-access-secret
JWT_REFRESH_SECRET=CAMBIA-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STORAGE_SIGNING_SECRET=CAMBIA-signing-secret

# ── Almacenamiento de medios (SeaweedFS en Docker, publicado en loopback) ──
STORAGE_DRIVER=s3
# Endpoint para el SDK (PUT/HEAD/crear bucket): el contenedor de SeaweedFS en el host.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=stream-music
# Deben coincidir con docker/seaweedfs/s3.json (¡cambiá el secret por defecto!).
S3_ACCESS_KEY=streammusic
S3_SECRET_KEY=CAMBIA-el-secret-de-seaweedfs
# URL pública navegable de los assets, servida por nginx en /s3/<bucket>.
S3_PUBLIC_URL=https://stream.duglasm.com/s3/stream-music
# El bucket sirve lectura pública/anónima (como en dev): entrega URLs públicas, no presigned.
S3_PUBLIC_READ=true

# ── Email (SMTP real de producción; password resets y verificación) ──
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_FROM=Stream Music <no-reply@duglasm.com>

# ── Seeder del admin inicial (npm/seed:prod) — ver DEPLOYMENT.md ──
ADMIN_EMAIL=admin@duglasm.com
ADMIN_PASSWORD=CAMBIA-clave-admin-min-8

# ── Opcionales ──
# Búsqueda: 'auto' (default) usa Mongo si no hay Meilisearch. Dejar sin MEILI_HOST.
# SEARCH_DRIVER=auto
# Monitoreo de errores:
# SENTRY_DSN=
# APP_RELEASE=
# Proveedores de metadatos / IA (si se usan):
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# OPENAI_API_KEY=
# Login social (callbacks: https://stream.duglasm.com/api/v1/auth/social/<prov>/callback):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
