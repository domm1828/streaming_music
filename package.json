{
  "name": "stream-music",
  "version": "2.1.5",
  "private": true,
  "description": "Stream Music — plataforma de streaming musical (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @stream-music/api & npm run dev --workspace @stream-music/web",
    "dev:api": "npm run dev --workspace @stream-music/api",
    "dev:web": "npm run dev --workspace @stream-music/web",
    "seed": "npm run seed --workspace @stream-music/api",
    "seed:prod": "npm run seed:prod --workspace @stream-music/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
